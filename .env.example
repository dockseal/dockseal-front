MODE=development
VITE_API_URL=http://localhost:8000
VITE_ENABLE_API_DELAY=false
VITE_ENABLE_DEVTOOLS=false

# Sentry (deixe VITE_SENTRY_DSN vazio para desligar)
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=local
VITE_SENTRY_RELEASE=
# Deixar o RATE em 1.0 para testar // Em produção deixe em 0.2 senao sa praga vai estourar a cota
VITE_SENTRY_TRACES_SAMPLE_RATE=1.0